# Copy to `.env` next to docker-compose.yml and adjust.
MDHUB_PORT=8080

# Bootstrap platform administrator (created on first start, change password at first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Now-123

# Set to true when served over HTTPS (secure cookies). TRUST_PROXY when behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# Create demo company "acme" (acme-admin / editor / viewer, password Demo-Pass-1234)
SEED_DEMO=false

LOG_LEVEL=info
