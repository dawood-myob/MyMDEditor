{
  "name": "mdhub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MDHub - multi-tenant real-time collaborative Markdown server",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^11.0.0",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "html-to-docx": "^1.8.0",
    "lib0": "^0.2.120",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "puppeteer-core": "^25.19.0",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "y-websocket": "^3.1.0"
  }
}
